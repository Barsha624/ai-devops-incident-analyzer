# Copy to .env for local use. .env is git-ignored. NEVER commit real keys.
# The core tool needs none of these. They only matter for the optional AI feature.

# External AI provider keys (only read when you opt in with --ai --allow-external-ai):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Hard kill switch: set to 1 to disable ALL AI features, whatever the flags or config say.
# INCIDENT_ANALYZER_DISABLE_AI=1

# AWS credentials come from the normal AWS chain (profile / SSO / instance role).
# Do not put long-lived access keys in this file.
